rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          'email_verified' in request.auth.token &&
          request.auth.token.email_verified == true &&
          'email' in request.auth.token &&
          request.auth.token.email == 'pranavsmmsupport@gmail.com'
        )
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.publicId is string && data.publicId.matches('^LUM-[A-Z0-9]{8}$') &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             data.isPublic is bool &&
             data.vipStatus in ['free', 'trial', 'vip', 'lifetime'] &&
             data.isBanned is bool &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128)) &&
             (!('activeLicenseCode' in data) || (data.activeLicenseCode is string && data.activeLicenseCode.size() >= 6 && data.activeLicenseCode.size() <= 64)) &&
             (!('trialStartedAt' in data) || data.trialStartedAt is timestamp) &&
             (!('trialExpiresAt' in data) || data.trialExpiresAt is timestamp) &&
             (!('vipExpiresAt' in data) || data.vipExpiresAt is timestamp) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidPrivateAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('provider' in data) || (data.provider is string && data.provider.size() <= 64)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.publicId is string && data.publicId.matches('^LUM-[A-Z0-9]{8}$') &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             data.isPublic is bool &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('followersCount' in data) || (data.followersCount is int && data.followersCount >= 0)) &&
             (!('followingCount' in data) || (data.followingCount is int && data.followingCount >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidUsernameClaim(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.publicId is string && data.publicId.matches('^LUM-[A-Z0-9]{8}$') &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 40 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFollow(data) {
      return data.followerUid is string && data.followerUid.size() >= 1 && data.followerUid.size() <= 128 &&
             data.targetUid is string && data.targetUid.size() >= 1 && data.targetUid.size() <= 128 &&
             data.followerUid != data.targetUid &&
             data.targetPublicId is string && data.targetPublicId.matches('^LUM-[A-Z0-9]{8}$') &&
             data.status in ['pending', 'accepted'] &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidChatSession(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.provider is string && data.provider.size() >= 1 && data.provider.size() <= 64 &&
             data.model is string && data.model.size() >= 1 && data.model.size() <= 120 &&
             (!('lastMessagePreview' in data) || (data.lastMessagePreview is string && data.lastMessagePreview.size() <= 500)) &&
             (!('messageCount' in data) || (data.messageCount is int && data.messageCount >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidChatMessage(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.role in ['user', 'model', 'system'] &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 32000 &&
             (!('model' in data) || (data.model is string && data.model.size() <= 120)) &&
             (!('latencyMs' in data) || (data.latencyMs is int && data.latencyMs >= 0)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidMemoryItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.category in ['preference', 'fact', 'summary', 'instruction'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4000 &&
             data.isPinned is bool &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidProject(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.projectType in ['website', 'android_app'] &&
             data.buildStatus in ['draft', 'building', 'ready', 'failed'] &&
             data.deploymentStatus in ['not_deployed', 'deployed', 'blocked', 'removed'] &&
             data.isModerated is bool &&
             (!('ownerPublicId' in data) || (data.ownerPublicId is string && data.ownerPublicId.size() <= 32)) &&
             (!('framework' in data) || (data.framework is string && data.framework.size() <= 64)) &&
             (!('packageName' in data) || (data.packageName is string && data.packageName.size() <= 128)) &&
             (!('publicUrl' in data) || (data.publicUrl is string && data.publicUrl.size() <= 500)) &&
             (!('version' in data) || (data.version is string && data.version.size() <= 32)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000)) &&
             (!('moderationReason' in data) || (data.moderationReason is string && data.moderationReason.size() <= 500)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidAgentTask(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.agentType is string && data.agentType.size() >= 1 && data.agentType.size() <= 64 &&
             data.agentName is string && data.agentName.size() >= 1 && data.agentName.size() <= 80 &&
             data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 4000 &&
             data.status in ['queued', 'running', 'completed', 'cancelled', 'failed'] &&
             (!('resultSummary' in data) || (data.resultSummary is string && data.resultSummary.size() <= 8000)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             data.isRead is bool &&
             (!('type' in data) || (data.type is string && data.type.size() <= 40)) &&
             isValidTimestamp(data.createdAt);
    }

    function isValidLicense(data) {
      return data.code is string && data.code.size() >= 6 && data.code.size() <= 64 &&
             data.tier in ['vip', 'lifetime'] &&
             data.durationDays is int && data.durationDays >= 0 && data.durationDays <= 36500 &&
             data.isActive is bool &&
             (!('redeemedByUid' in data) || (data.redeemedByUid is string && data.redeemedByUid.size() <= 128)) &&
             (!('boundDeviceId' in data) || (data.boundDeviceId is string && data.boundDeviceId.size() <= 128)) &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
             data.severity in ['info', 'warning', 'critical'] &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidAppConfig(data) {
      return data.maintenanceMode is bool &&
             (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 500)) &&
             (!('minSupportedVersion' in data) || (data.minSupportedVersion is string && data.minSupportedVersion.size() <= 32)) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
             data.details is string && data.details.size() >= 1 && data.details.size() <= 2000 &&
             (!('targetUid' in data) || (data.targetUid is string && data.targetUid.size() <= 128)) &&
             (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128)) &&
             isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    // 1. Admins registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // 2. Users (Split PII: private/account holds email)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'publicId', 'username', 'isPublic', 'vipStatus', 'isBanned', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'publicId', 'username', 'bio', 'avatarUrl', 'isPublic', 'vipStatus', 'deviceId', 'isBanned', 'trialStartedAt', 'trialExpiresAt', 'vipExpiresAt', 'createdAt', 'updatedAt']) &&
                       incoming().vipStatus in ['free', 'trial'] &&
                       incoming().isBanned == false &&
                       !('vipExpiresAt' in incoming()) &&
                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().publicId == existing().publicId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           isOwner(userId) &&
                           incoming().isBanned == existing().isBanned &&
                           (
                             // Standard profile edit (cannot mutate VIP/trial/ban)
                             (
                               incoming().vipStatus == existing().vipStatus &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'avatarUrl', 'isPublic', 'deviceId', 'updatedAt'])
                             ) ||
                             // One-time trial start (only if not yet started)
                             (
                               existing().vipStatus == 'free' &&
                               !('trialStartedAt' in existing()) &&
                               incoming().vipStatus == 'trial' &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['vipStatus', 'trialStartedAt', 'trialExpiresAt', 'deviceId', 'updatedAt'])
                             ) ||
                             // Redeem active unused license key atomically in same batch
                             (
                               incoming().vipStatus in ['vip', 'lifetime'] &&
                               'activeLicenseCode' in incoming() &&
                               isValidId(incoming().activeLicenseCode) &&
                               get(/databases/$(database)/documents/licenses/$(incoming().activeLicenseCode)).data.isActive == true &&
                               !('redeemedByUid' in get(/databases/$(database)/documents/licenses/$(incoming().activeLicenseCode)).data) &&
                               getAfter(/databases/$(database)/documents/licenses/$(incoming().activeLicenseCode)).data.redeemedByUid == request.auth.uid &&
                               incoming().diff(existing()).affectedKeys().hasOnly(['vipStatus', 'vipExpiresAt', 'activeLicenseCode', 'deviceId', 'updatedAt'])
                             )
                           )
                         )
                       );

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // Private PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && isValidId(docId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'email', 'provider', 'createdAt', 'updatedAt']) &&
                         isValidPrivateAccount(incoming());
        allow update: if isValidId(userId) && isValidId(docId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidPrivateAccount(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['email', 'provider', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }

      // Chats
      match /chats/{chatId} {
        allow get: if isValidId(userId) && isValidId(chatId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(chatId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'provider', 'model', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'provider', 'model', 'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt']) &&
                         isValidChatSession(incoming());
        allow update: if isValidId(userId) && isValidId(chatId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChatSession(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'provider', 'model', 'lastMessagePreview', 'messageCount', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(chatId) && isOwner(userId);

        match /messages/{messageId} {
          allow get: if isValidId(userId) && isValidId(chatId) && isValidId(messageId) && isOwner(userId);
          allow list: if isOwner(userId);
          allow create: if isValidId(userId) && isValidId(chatId) && isValidId(messageId) && isOwner(userId) &&
                           incoming().userId == request.auth.uid &&
                           incoming().keys().hasAll(['userId', 'role', 'content', 'createdAt']) &&
                           incoming().keys().hasOnly(['userId', 'role', 'content', 'model', 'latencyMs', 'createdAt']) &&
                           isValidChatMessage(incoming());
          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(chatId) && isValidId(messageId) && isOwner(userId);
        }
      }

      // User-controlled AI Memories
      match /memories/{memoryId} {
        allow get: if isValidId(userId) && isValidId(memoryId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(memoryId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'category', 'title', 'content', 'isPinned', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'category', 'title', 'content', 'isPinned', 'createdAt', 'updatedAt']) &&
                         isValidMemoryItem(incoming());
        allow update: if isValidId(userId) && isValidId(memoryId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMemoryItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'content', 'isPinned', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(memoryId) && isOwner(userId);
      }

      // Multi-agent task runs
      match /agentTasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isValidId(userId) && isValidId(taskId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'agentType', 'agentName', 'prompt', 'status', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'agentType', 'agentName', 'prompt', 'status', 'resultSummary', 'createdAt', 'updatedAt']) &&
                         isValidAgentTask(incoming());
        allow update: if isValidId(userId) && isValidId(taskId) && isOwner(userId) &&
                         !(existing().status in ['completed', 'cancelled', 'failed']) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidAgentTask(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resultSummary', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      // User notifications
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin()) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'body', 'isRead', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'body', 'type', 'isRead', 'createdAt']) &&
                         isValidNotification(incoming());
        allow update: if isValidId(userId) && isValidId(notificationId) && isOwner(userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNotification(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isValidId(userId) && isValidId(notificationId) && (isOwner(userId) || isAdmin());
      }
    }

    // 3. Public Profiles (non-PII, keyed by permanent publicId)
    match /publicProfiles/{publicId} {
      allow get: if isValidId(publicId) && isSignedIn() && (existing().isPublic == true || existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(publicId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().publicId == publicId &&
                       incoming().keys().hasAll(['userId', 'publicId', 'username', 'isPublic', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'publicId', 'username', 'bio', 'avatarUrl', 'isPublic', 'followersCount', 'followingCount', 'createdAt', 'updatedAt']) &&
                       isValidPublicProfile(incoming());
      allow update: if isValidId(publicId) && isValidPublicProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().publicId == existing().publicId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'avatarUrl', 'isPublic', 'followersCount', 'followingCount', 'updatedAt'])
                         )
                       );
      allow delete: if isValidId(publicId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // 4. Unique Username Index
    match /usernames/{usernameLower} {
      allow get: if isValidId(usernameLower) && isSignedIn();
      allow list: if isAdmin();
      allow create: if isValidId(usernameLower) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'publicId', 'username', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'publicId', 'username', 'createdAt']) &&
                       isValidUsernameClaim(incoming());
      allow update: if false;
      allow delete: if isValidId(usernameLower) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // 5. Follow Graph
    match /follows/{followId} {
      allow get: if isValidId(followId) && isSignedIn() &&
                    (existing().followerUid == request.auth.uid || existing().targetUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.followerUid == request.auth.uid || resource.data.targetUid == request.auth.uid || isAdmin());
      allow create: if isValidId(followId) && isSignedIn() &&
                       incoming().followerUid == request.auth.uid &&
                       incoming().keys().hasAll(['followerUid', 'targetUid', 'targetPublicId', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerUid', 'targetUid', 'targetPublicId', 'status', 'createdAt', 'updatedAt']) &&
                       isValidFollow(incoming());
      allow update: if isValidId(followId) && isSignedIn() &&
                       existing().targetUid == request.auth.uid &&
                       existing().status == 'pending' &&
                       incoming().status == 'accepted' &&
                       incoming().followerUid == existing().followerUid &&
                       incoming().targetUid == existing().targetUid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidFollow(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(followId) && isSignedIn() &&
                       (existing().followerUid == request.auth.uid || existing().targetUid == request.auth.uid || isAdmin());
    }

    // 6. Studio Projects (Website Studio & Android App Studio)
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() &&
                    (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(projectId) && isSignedIn() &&
                       incoming().userId == request.auth.uid &&
                       incoming().isModerated == false &&
                       incoming().deploymentStatus == 'not_deployed' &&
                       incoming().keys().hasAll(['userId', 'name', 'projectType', 'buildStatus', 'deploymentStatus', 'isModerated', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'ownerPublicId', 'name', 'projectType', 'framework', 'packageName', 'buildStatus', 'deploymentStatus', 'publicUrl', 'version', 'summary', 'isModerated', 'moderationReason', 'createdAt', 'updatedAt']) &&
                       isValidProject(incoming());
      allow update: if isValidId(projectId) && isValidProject(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (
                           existing().userId == request.auth.uid &&
                           existing().isModerated == false &&
                           incoming().isModerated == false &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'framework', 'packageName', 'buildStatus', 'deploymentStatus', 'publicUrl', 'version', 'summary', 'updatedAt'])
                         )
                       );
      allow delete: if isValidId(projectId) && isSignedIn() &&
                       (existing().userId == request.auth.uid || isAdmin());
    }

    // 7. Licenses (VIP / Lifetime)
    match /licenses/{licenseKey} {
      allow get: if isValidId(licenseKey) && isSignedIn();
      allow list, create, delete: if isAdmin();
      allow update: if isValidId(licenseKey) && isValidLicense(incoming()) && (
        isAdmin() ||
        (
          isSignedIn() &&
          existing().isActive == true &&
          !('redeemedByUid' in existing()) &&
          incoming().redeemedByUid == request.auth.uid &&
          incoming().code == existing().code &&
          incoming().tier == existing().tier &&
          incoming().durationDays == existing().durationDays &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['redeemedByUid', 'boundDeviceId', 'isActive', 'updatedAt'])
        )
      );
    }

    // 8. Announcements & Global Config
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && isSignedIn() && (existing().isActive == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.isActive == true || isAdmin());
      allow create, update, delete: if isValidId(announcementId) && isAdmin() && isValidAnnouncement(incoming());
    }

    match /config/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isValidId(configId) && isAdmin() && isValidAppConfig(incoming());
      allow delete: if false;
    }

    // 9. Audit Logs (Append-Only)
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isAdmin() && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
